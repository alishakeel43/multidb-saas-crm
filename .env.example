APP_NAME='Krayin CRM'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
TENANT_BASE_DOMAIN=localhost
TENANT_DOMAIN_SUFFIX=
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_CURRENCY=USD

VITE_HOST=
VITE_PORT=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Supported: tenant, mysql, mariadb
DB_CONNECTION=tenant
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel-crm
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=
TENANT_DB_DATABASE=
LANDLORD_DB_DATABASE=zaristech_saas
TENANT_DATABASE_ALLOWED_HOSTS=127.0.0.1
TENANT_DATABASE_ALLOWED_PORTS="${DB_PORT}"
TENANT_PROTECTED_DATABASES=zaristech_saas,tenant_bootstrap

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=laravel@krayincrm.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DOMAIN=webkul.com

MAIL_RECEIVER_DRIVER=sendgrid

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=your_username
IMAP_PASSWORD=your_password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

UNIFIED_INBOX_META_APP_ID=
UNIFIED_INBOX_META_APP_SECRET=
UNIFIED_INBOX_META_VERSION=v21.0
UNIFIED_INBOX_META_VERIFY_TOKEN=
UNIFIED_INBOX_WHATSAPP_CONFIG_ID=
UNIFIED_INBOX_MESSAGING_CONFIG_ID=
UNIFIED_INBOX_WEBHOOK_URL=
# One Meta Valid OAuth Redirect URI for every tenant (defaults to https://{APP_HOST}/api/meta/oauth/callback)
UNIFIED_INBOX_OAUTH_REDIRECT_URL=
# true = Development scopes login + App Review helpers on Channels
UNIFIED_INBOX_ALLOW_MANUAL_CONNECT=false

SAAS_ENFORCE_SUBSCRIPTION=false
SAAS_DEFAULT_STORAGE_QUOTA_MB=1024
SAAS_DEFAULT_CURRENCY="${APP_CURRENCY}"
SAAS_TAX_PERCENT=0
SAAS_INVOICE_PREFIX=INV
SAAS_TENANT_BACKUP_RETENTION_DAYS=14

ACTIVITY_LOGGER_DB_CONNECTION=landlord
HEALTH_DB_CONNECTION=landlord

# Playwright Super Admin e2e (packages/Webkul/Admin/tests/e2e-pw/tests/saas)
PLATFORM_ADMIN_EMAIL=e2e-platform@zaris.test
PLATFORM_ADMIN_PASSWORD=E2ePlatformAdmin!234

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ---------------------------------------------------------------
# Unified Inbox AI reply suggestions (OpenAI-compatible chat API)
# UNIFIED_INBOX_AI_PROVIDER: grok (xAI) | custom (local Ollama/LM Studio/etc.) | openai
# UNIFIED_INBOX_AI_API_KEY : provider API key. Required for grok/openai; optional for custom.
#                            Never commit a real key - set it in .env only.
# UNIFIED_INBOX_AI_MODEL   : blank = provider default (grok: grok-3-mini, openai: gpt-4o-mini).
#                            Required for custom (e.g. llama3.2).
# UNIFIED_INBOX_AI_BASE_URL: blank = provider default (grok: https://api.x.ai/v1,
#                            openai: https://api.openai.com/v1). Required for custom.
# UNIFIED_INBOX_AI_TIMEOUT : request timeout in seconds.
# If no key is set (and not custom), Krayin Magic AI settings are used as fallback.
# ---------------------------------------------------------------
UNIFIED_INBOX_AI_PROVIDER=grok
UNIFIED_INBOX_AI_API_KEY=
UNIFIED_INBOX_AI_MODEL=grok-3-mini
UNIFIED_INBOX_AI_BASE_URL=https://api.x.ai/v1
UNIFIED_INBOX_AI_TIMEOUT=20
# Custom local LLM example (Ollama):
# UNIFIED_INBOX_AI_PROVIDER=custom
# UNIFIED_INBOX_AI_BASE_URL=http://localhost:11434/v1
# UNIFIED_INBOX_AI_MODEL=llama3.2
# UNIFIED_INBOX_AI_API_KEY=ollama
# LM Studio: UNIFIED_INBOX_AI_BASE_URL=http://127.0.0.1:1234/v1
# OpenAI example:
# UNIFIED_INBOX_AI_PROVIDER=openai
# UNIFIED_INBOX_AI_MODEL=gpt-4o-mini
# UNIFIED_INBOX_AI_BASE_URL=https://api.openai.com/v1
